# Cloudflare Pages redirects (copied into public/ by zola build).
# Old WordPress page URLs -> their Zola pages; 301 so links and search
# rankings carry over. Old /wp-* paths are handled in functions/ instead,
# because a few need a 410 and _redirects can only redirect.
/home/                              /                          301
/eye-drops/                         /patients/eye-drops/       301
/eye-drop-form/                     /patients/eye-drop-form/   301
/eye-drop-schedule/                 /patients/eye-drop-form/   301
/postop-information/                /patients/post-op-schedule/ 301
/post-op-eye-drop-form-generator/   /patients/post-op-schedule/ 301
/generate-post-op-drop-schedule/    /patients/post-op-schedule/ 301
