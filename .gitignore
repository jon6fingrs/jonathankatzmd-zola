# Build output — regenerated by `zola build`, never belongs in git.
/public/

# The site no longer uses a theme; ignored so an old local themes/ folder
# from before the move can't be committed by accident.
/themes/

# Contains real secrets: SMTP_PASSWORD, TOKEN_SECRET. Commit
# docker-compose.yml.example instead.
docker-compose.yml

# No secrets, but is deployment-specific (container names, internal routing
# tied to this one host). Commit nginx.conf.example instead.
nginx.conf

# Fetched images — large binaries pulled from the old WordPress install by
# fetch-assets.sh, not hand-authored. Remove this line if you'd rather
# track them in git (fine at this size; consider Git LFS if it grows).
# /static/images/

# OS / editor cruft
.DS_Store
*.swp

# Zola writes resized images here at build time (resize_image); regenerated every build.
/static/processed_images/

# Theme sample assets that `cp -rn themes/<theme>/static/. static/` used to drag in. Not part of the site.
/static/sections/
/static/images/about/
/static/images/blog/
/static/images/contact/
/static/images/hero/
/static/images/portfolio/
/static/images/service/
/static/images/skill/
/static/fonts/LineIcons.*
/static/fonts/slick.*
